FROM apache/spark:3.5.9-python3

USER root

RUN pip install --no-cache-dir \
    --retries 5 \
    --timeout 120 \
    numpy==2.1.3 \
    pandas==2.2.3 \
    scipy==1.14.1 \
    jupyterlab==4.2.5 \
    matplotlib==3.9.2 \
    seaborn==0.13.2

RUN mkdir -p /opt/spark/conf && \
    echo "spark.jars.packages org.apache.httpcomponents.client5:httpclient5:5.3.1" > /opt/spark/conf/spark-defaults.conf && \
    echo "spark.jars.ivy /home/spark/.ivy2" >> /opt/spark/conf/spark-defaults.conf

RUN mkdir -p /home/spark && chown spark:spark /home/spark


USER spark

ENV HOME=/home/spark