FROM apache/spark:3.5.9-python3

USER root

RUN pip install \
    --retries 5 \
    --timeout 120 \
    numpy==2.1.3 \
    pandas==2.2.3 \
    scipy==1.14.1 \
    jupyterlab==4.2.5 \
    matplotlib==3.9.2 \
    seaborn==0.13.2

RUN wget -q -P /opt/spark/jars/ \
    https://repo1.maven.org/maven2/com/clickhouse/clickhouse-jdbc/0.6.5/clickhouse-jdbc-0.6.5-shaded.jar
RUN mkdir -p /home/spark && chown spark:spark /home/spark


USER spark
ENV PYTHONPATH=/opt/spark/python:/opt/spark/python/lib/py4j-0.10.9.7-src.zip
ENV HOME=/home/spark